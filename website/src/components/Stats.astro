---
// Headline numbers under the hero, read from the same results as the benchmark charts so they can't drift apart.
import { comparison, type Group } from '../data/benchmarks';

const row = (group: Group, scenario: string) => {
	const r = comparison[group].find((r) => r.scenario === scenario);
	if (!r) throw new Error(`no ${group} benchmark named ${scenario}`);
	return r;
};

const here = row('location', 'Here, as a string');
const parallel = row('location', 'Here, as a string, 16 callers at once');
const slog = row('logging', 'slog JSON line');

const stats = [
	{ value: `${(here.before.ns / here.after.ns).toFixed(1)}×`, label: 'faster than v1 to get a frame as a string' },
	{
		value: `${here.after.allocs}`,
		label: `allocations to capture a frame and format it, where v1 made ${here.before.allocs}`,
	},
	{
		value: `${(parallel.before.ns / parallel.after.ns).toFixed(0)}×`,
		label: 'faster than v1 with 16 callers at once',
	},
	{
		value: `${(slog.before.allocs / slog.after.allocs).toFixed(0)}×`,
		label: 'fewer allocations than v1 for a slog line with a frame',
	},
];
---

<ul class="stats not-content">
	{
		stats.map((s) => (
			<li>
				<span class="value">{s.value}</span>
				<span class="label">{s.label}</span>
			</li>
		))
	}
</ul>

<style>
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-hairline-light);
	}

	li {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 1.25rem 1.5rem;
		background: var(--sl-color-bg);
	}

	.value {
		font-size: var(--sl-text-3xl);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}

	.label {
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-3);
	}
</style>
